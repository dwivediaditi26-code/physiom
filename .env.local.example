# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is never committed and only ever read on this machine / by
# Vercel's own env-var store -- never put real secrets in this .example file.
#
# None of these are needed just to run `npm run dev`: without them the app
# uses the production Supabase project (the fallback in src/supabase.js), and
# the /api/* functions only run on Vercel anyway. Production values live in
# Vercel -> Project Settings -> Environment Variables.

# --- Browser (baked into the built app; must start with VITE_) ---------------
# A different Supabase project, e.g. the disposable test project e2e.yml uses.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sentry crash reporting -- stays off when empty.
VITE_SENTRY_DSN=

# --- Server only (api/*.js on Vercel -- never prefix these with VITE_) -------
# Groq LLM key for /api/parse, /api/chat and /api/extract*NoteVariables.
GROQ_API_KEY=
# Supabase admin access for /api/deleteAccount and the /api rate limiter
# (api/_lib/rateLimit.js). SUPABASE_URL defaults to the production project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
